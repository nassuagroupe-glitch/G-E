{
  "name": "@ge/desktop",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "electron .",
    "dev:live": "cross-env ELECTRON_START_URL=http://localhost:5173 electron .",
    "build:renderer": "npm run build --workspace=@ge/web && node scripts/copy-web-build.mjs",
    "build": "npm run build:renderer && electron-builder --win",
    "pack": "npm run build:renderer && electron-builder --dir"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "electron": "^32.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.nassuagroupe.ge",
    "productName": "G&E",
    "electronVersion": "32.3.3",
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "web-dist/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    }
  }
}
